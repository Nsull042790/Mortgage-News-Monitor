# Slack Configuration
# Option 1: Webhook URL (recommended - simpler setup)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Option 2: Bot Token (requires channel ID)
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# SLACK_CHANNEL_ID=C0123456789

# News API Keys
NEWS_API_KEY=your-newsapi-key-here
GNEWS_API_KEY=your-gnews-api-key-here

# Monitoring Configuration
# How often to check for breaking news (in minutes)
BREAKING_NEWS_CHECK_INTERVAL=15

# Daily digest time (24-hour format, e.g., 08:00)
DAILY_DIGEST_TIME=08:00

# Timezone for scheduling (e.g., America/New_York, America/Los_Angeles)
TIMEZONE=America/New_York

# Business hours - only monitor during these hours to save Railway free tier
# 6am to 8pm weekdays = ~308 hours/month (well under 500 free hours)
BUSINESS_HOURS_START=6
BUSINESS_HOURS_END=20

# Database path (SQLite)
DATABASE_PATH=./data/mortgage_news.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
